<Window x:Class="FalloutLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fallout 4 Launcher (MO2 + Root Builder)"
        Height="500" Width="700"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: кнопка запуска и переключатель темы -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Button x:Name="btnLaunch" Content="Запустить Fallout 4" 
                    Width="200" Height="35" 
                    Click="BtnLaunch_Click"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextForeground}"
                    FontSize="14" FontWeight="Bold"/>

            <TextBlock Text="  " Width="10"/>

            <ToggleButton x:Name="btnTheme" Content="🌙 Тёмная тема" 
                          Width="150" Height="35"
                          Click="BtnTheme_Click"
                          Background="{DynamicResource ButtonBackground}"
                          Foreground="{DynamicResource TextForeground}"
                          FontSize="12"/>
        </StackPanel>

        <!-- Лог-область -->
        <TextBox x:Name="txtLog" Grid.Row="1"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="{DynamicResource WindowBackground}"
                 Foreground="{DynamicResource TextForeground}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalAlignment="Stretch"/>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0"
                   Background="{DynamicResource ButtonBackground}"
                   Foreground="{DynamicResource TextForeground}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов к запуску"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>