<Window x:Class="FalloutLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FalloutLauncher"
        Title="FEH Launcher"
        Icon="ico.ico"
        Height="760" Width="940"
        MinHeight="720" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Closing="MainWindow_Closing"
        SizeChanged="MainWindow_SizeChanged"
        ResizeMode="CanResize"
        Background="#FF0D1117"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- ==================== RESOURCES ==================== -->
    <Window.Resources>
        <!-- ─── Accent Colors ─── -->
        <Color x:Key="AccentColor">#FF7C4DFF</Color>
        <Color x:Key="AccentLightColor">#FFB388FF</Color>
        <Color x:Key="AccentDarkColor">#FF651FFF</Color>

        <!-- ─── Dark Theme ─── -->
        <Color x:Key="DarkBg">#FF0D1117</Color>
        <Color x:Key="DarkSurface">#FF161B22</Color>
        <Color x:Key="DarkCard">#FF21262D</Color>
        <Color x:Key="DarkBorder">#FF30363D</Color>
        <Color x:Key="DarkTextPrimary">#FFE6EDF3</Color>
        <Color x:Key="DarkTextSecondary">#FF8B949E</Color>
        <Color x:Key="DarkLogBg">#FF090B10</Color>
        <Color x:Key="DarkTitleBg">#FF0D1117</Color>

        <!-- ─── Light Theme ─── -->
        <!-- Тёплая бумажная палитра: Bg (крем) > Surface (тёплый off-white) > Card (светлый off-white) -->
        <Color x:Key="LightBg">#FFF7F6F3</Color>
        <Color x:Key="LightSurface">#FFF2F0EB</Color>
        <Color x:Key="LightCard">#FFFAF9F6</Color>
        <Color x:Key="LightBorder">#FFCFC9BE</Color>
        <Color x:Key="LightTextPrimary">#FF262522</Color>
        <Color x:Key="LightTextSecondary">#FF6B6B68</Color>
        <Color x:Key="LightLogBg">#FFF5F3EF</Color>
        <Color x:Key="LightTitleBg">#FFF2F0EB</Color>

        <!-- ─── Dynamic Brushes (swapped by code-behind) ─── -->
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource DarkBg}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurface}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource DarkCard}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/>
        <SolidColorBrush x:Key="TitleBgBrush" Color="{StaticResource DarkTitleBg}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
        <SolidColorBrush x:Key="LogBgBrush" Color="{StaticResource DarkLogBg}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

        <!-- ─── Hover Overlay (swapped by code-behind for light/dark theme) ─── -->
        <Color x:Key="HoverOverlayColor">#FFFFFFFF</Color>

        <!-- ─── Fonts ─── -->
        <FontFamily x:Key="FontPrimary">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Code, Consolas, monospace</FontFamily>

        <!-- ─── Styles ─── -->

        <Style x:Key="ActionCardBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="root" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverOverlayColor}" Opacity="0.10"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="root" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="4,2"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverOverlayColor}" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverOverlayColor}" Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <!-- ==================== MAIN LAYOUT ==================== -->
    <Grid>
        <!-- Outer border (window frame) -->
        <Border x:Name="windowFrame"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Title Bar -->
                    <RowDefinition Height="44"/>
                    <!-- Row 1: Content -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== TITLE BAR ==================== -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBgBrush}"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        x:Name="titleBar"
                        MouseDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App icon + title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Image Source="ico.ico" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="FEH Launcher"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Spacer / window drag area -->
                        <Grid Grid.Column="1"/>

                        <!-- Theme toggle -->
                        <Button x:Name="btnTheme"
                                Grid.Column="2"
                                Style="{StaticResource WindowBtn}"
                                Width="40"
                                Click="BtnTheme_Click"
                                ToolTip="Переключить тему">
                            <TextBlock x:Name="btnThemeIcon" Text="🌙" FontSize="14"/>
                        </Button>

                        <!-- Minimize -->
                        <Button Grid.Column="3" Style="{StaticResource WindowBtn}" Click="BtnMinimize_Click"
                                ToolTip="Свернуть">
                            <Path Data="M0,0 L12,0" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button x:Name="btnMaximize" Grid.Column="4" Style="{StaticResource WindowBtn}"
                                Click="BtnMaximize_Click" ToolTip="Развернуть">
                            <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="maxIcon" Stroke="{DynamicResource TextPrimaryBrush}"
                                           StrokeThickness="1.5" Fill="Transparent"/>
                            </Grid>
                        </Button>

                        <!-- Close -->
                        <Button Grid.Column="5" Style="{StaticResource CloseBtn}" Click="BtnClose_Click"
                                ToolTip="Закрыть">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== MAIN CONTENT ==================== -->
                <Grid Grid.Row="1" Margin="0">
                    <!-- Sidebar + content layer -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ─── Sidebar ─── -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                                <RadioButton x:Name="navHome" GroupName="SidebarNav"
                                             Style="{StaticResource SidebarItemStyle}"
                                             IsChecked="True"
                                             ToolTip="Главная"
                                             Checked="Nav_Checked">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M3,9 L9,2 L21,9 V20 A2,2 0 0,1 19,22 H5 A2,2 0 0,1 3,20 Z M9,22 L9,12 L15,12 L15,22"/>
                                </RadioButton>
                                <RadioButton x:Name="navMods" GroupName="SidebarNav"
                                             Style="{StaticResource SidebarItemStyle}"
                                             ToolTip="Опциональные моды"
                                             Checked="Nav_Checked">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M21,16 V8 A2,2 0 0,0 20,6.27 L13,2.27 A2,2 0 0,0 11,2.27 L4,6.27 A2,2 0 0,0 3,8 V16 A2,2 0 0,0 4,17.73 L11,21.73 A2,2 0 0,0 13,21.73 L20,17.73 A2,2 0 0,0 21,16 Z M3.27,6.96 L12,12.01 L20.73,6.96 M12,22.08 L12,12"/>
                                </RadioButton>
                                <RadioButton x:Name="navSaves" GroupName="SidebarNav"
                                             Style="{StaticResource SidebarItemStyle}"
                                             ToolTip="Сохранения"
                                             Checked="Nav_Checked">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M19,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H16 L21,8 V19 A2,2 0 0,1 19,21 Z M17,21 V13 H7 V21 M7,3 V8 H15"/>
                                </RadioButton>
                                <RadioButton x:Name="navAbout" GroupName="SidebarNav"
                                             Style="{StaticResource SidebarItemStyle}"
                                             ToolTip="О программе"
                                             Checked="Nav_Checked">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 Z M12,8 V12 M12,16 L12.01,16"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- ─── Content Area ─── -->
                        <ScrollViewer Grid.Column="1"
                                      Style="{StaticResource ModernScrollViewer}"
                                      Background="{DynamicResource BgBrush}"
                                      Padding="20">
                                        <StackPanel x:Name="contentPanel">

                            <!-- ======== SECTION: Welcome ======== -->
                            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="txtWelcome"
                                               Text="С возвращением!"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Fallout 4 готов к запуску через Mod Organizer 2"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,12"/>
                                    <Border Background="{DynamicResource LogBgBrush}"
                                            CornerRadius="6"
                                            Padding="12,8">
                                        <TextBlock x:Name="txtGamePath"
                                                   Text="Путь к игре: (определяется при запуске)"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ======== SECTION: Action Cards ======== -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card: Launch F4SE -->
                                <Button x:Name="btnLaunch" Grid.Column="0" Style="{StaticResource ActionCardBtn}" Margin="0,0,8,0"
                                        Click="BtnLaunch_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M5,3 L19,12 L5,21 Z"/>
                                        <TextBlock Text="Запустить F4SE"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock Text="Fallout 4 + F4SE + MO2"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card: Launch MO2 -->
                                <Button x:Name="btnMo2Only" Grid.Column="1" Style="{StaticResource ActionCardBtn}" Margin="4,0"
                                        Click="BtnLaunchMo2_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M22,19 A2,2 0 0,1 20,21 H4 A2,2 0 0,1 2,19 V5 A2,2 0 0,1 4,3 H9 L11,6 H20 A2,2 0 0,1 22,8 Z"/>
                                        <TextBlock Text="Запустить MO2"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock Text="Mod Organizer 2"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card: Mods -->
                                <Button Grid.Column="2" Style="{StaticResource ActionCardBtn}" Margin="8,0,0,0"
                                        Click="BtnMods_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" HorizontalAlignment="Center" Data="M21,16 V8 A2,2 0 0,0 20,6.27 L13,2.27 A2,2 0 0,0 11,2.27 L4,6.27 A2,2 0 0,0 3,8 V16 A2,2 0 0,0 4,17.73 L11,21.73 A2,2 0 0,0 13,21.73 L20,17.73 A2,2 0 0,0 21,16 Z M3.27,6.96 L12,12.01 L20.73,6.96 M12,22.08 L12,12"/>
                                        <TextBlock Text="Опциональные моды"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock Text="Вкл/выкл опциональные"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ======== SECTION: Saves ======== -->
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" Data="M19,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H16 L21,8 V19 A2,2 0 0,1 19,21 Z M17,21 V13 H7 V21 M7,3 V8 H15"/>
                                        <TextBlock Text="Сохранения"
                                                   FontFamily="{StaticResource FontPrimary}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Progress bar -->
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Background="{DynamicResource LogBgBrush}"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Height="10"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <ProgressBar x:Name="pbSaves"
                                                     Minimum="0" Maximum="100"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="#FF4CAF50"
                                                     Height="8"
                                                     Margin="1,0"/>
                                    </Border>

                                    <!-- Size label -->
                                    <TextBlock x:Name="lblSavesSize"
                                               Grid.Row="1" Grid.Column="2"
                                               Text="0.00 GB / 10.00 GB"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Open saves button (below) -->
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource StatusBarBtn}"
                                            Click="BtnOpenSaves_Click"
                                            ToolTip="Открыть папку сохранений">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="Открыть"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ======== SECTION: Log ======== -->
                            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" x:Name="logRow"/>
                                    </Grid.RowDefinitions>

                                    <!-- Log header (toggler) -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="8,8,0,0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" Data="M14,2 H6 A2,2 0 0,0 4,4 V20 A2,2 0 0,0 6,22 H18 A2,2 0 0,0 20,20 V8 Z M14,2 L14,8 L20,8 M16,13 H8 M16,17 H8"/>
                                                <TextBlock Text="Журнал"
                                                           FontFamily="{StaticResource FontPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock x:Name="txtStatus"
                                                       Grid.Column="1"
                                                       Text="Готов к запуску"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <ToggleButton x:Name="btnToggleLog"
                                                          Grid.Column="2"
                                                           Background="Transparent"
                                                          BorderThickness="0"
                                                          Cursor="Hand"
                                                          ToolTip="Свернуть/развернуть лог"
                                                          Checked="LogToggle_Changed"
                                                          Unchecked="LogToggle_Changed">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="6,2">
                                                            <TextBlock x:Name="arrow" Text="▼"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="arrow" Property="Text" Value="▲"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>

                                    <!-- Log content -->
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource LogBgBrush}"
                                            CornerRadius="0,0,8,8"
                                            Padding="14,10"
                                            x:Name="logContent"
                                            Height="140">
                                        <ScrollViewer x:Name="logScrollViewer" Style="{StaticResource ModernScrollViewer}">
                                            <TextBox x:Name="txtLog"
                                                     IsReadOnly="True"
                                                     FontFamily="{StaticResource FontMono}"
                                                     FontSize="11"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     BorderThickness="0"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                    <!-- ─── Overlay backdrop (panel open) ─── -->
                    <Border x:Name="modsOverlay"
                            Background="#80000000"
                            Visibility="Collapsed"
                            IsHitTestVisible="True"
                            MouseDown="ModsOverlay_MouseDown"/>

                    <!-- ─── Sliding Mods Panel ─── -->
                    <Border x:Name="modsPanelRoot"
                            Width="480"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="modsPanelSlide" X="480"/>
                        </Border.RenderTransform>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="8,0,0,8">
                            <local:ModsPanel x:Name="modsControl"/>
                        </Border>
                    </Border>
                </Grid>

                <!-- ==================== STATUS BAR ==================== -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8"
                        Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="lblStatusBar"
                                   Text="Готов к запуску"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Discord button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource StatusBarBtn}"
                                Click="BtnDiscord_Click"
                                ToolTip="Открыть Discord-сервер"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎧" FontSize="12" Margin="0,0,4,0" Height="16" Width="15" RenderTransformOrigin="0.722,0.51"/>
                                <TextBlock Text="Discord" RenderTransformOrigin="0.275,0.521" Width="45">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleY="-0.341"/>
                                            <RotateTransform/>
                                            <TranslateTransform Y="-0.067"/>
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Version -->
                        <TextBlock Grid.Column="3"
                                   Text="v1.2.0"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,4,0"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Resize grip overlay (bottom-right corner) -->
        <Rectangle Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Fill="{DynamicResource TextSecondaryBrush}"
                   Opacity="0.3"
                   IsHitTestVisible="False"
                   Margin="0,0,3,3"
                   Visibility="Collapsed"/>
    </Grid>
</Window>