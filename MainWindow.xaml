<Window x:Class="FalloutLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FNH Launcher by WhiteNight"
        Height="500" Width="700"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <!-- РЕСУРСЫ ОКНА (начальные значения + тёмные/светлые кисти) -->
    <Window.Resources>
        <!-- Тёмная тема -->
        <SolidColorBrush x:Key="WindowBackgroundDark" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="TextForegroundDark" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="ButtonBackgroundDark" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="LogBackgroundDark" Color="#FF2A2A2A"/>

        <!-- Светлая тема -->
        <SolidColorBrush x:Key="WindowBackgroundLight" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="TextForegroundLight" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="ButtonBackgroundLight" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="LogBackgroundLight" Color="#FFFFFFFF"/>

        <!-- Текущие значения (по умолчанию светлая тема) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="TextForeground" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="LogBackground" Color="#FFFFFFFF"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Button x:Name="btnLaunch" Content="🚀 Запустить игру (F4SE)" 
                    Width="180" Height="35" 
                    Click="BtnLaunch_Click"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextForeground}"
                    FontSize="14" FontWeight="Bold"/>

            <TextBlock Text="  " Width="10"/>

            <Button x:Name="btnMo2Only" Content="📂 Запустить MO2" 
                    Width="150" Height="35"
                    Click="BtnLaunchMo2_Click"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextForeground}"
                    FontSize="12"/>

            <TextBlock Text="  " Width="10"/>

            <ToggleButton x:Name="btnTheme" Content="🌙 Тёмная тема" 
                          Width="150" Height="35"
                          Click="BtnTheme_Click"
                          Background="{DynamicResource ButtonBackground}"
                          Foreground="{DynamicResource TextForeground}"
                          FontSize="12"/>
        </StackPanel>

        <!-- Лог -->
        <TextBox x:Name="txtLog" Grid.Row="1"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="{DynamicResource WindowBackground}"
                 Foreground="{DynamicResource TextForeground}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalAlignment="Stretch"/>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0"
                   Background="{DynamicResource ButtonBackground}"
                   Foreground="{DynamicResource TextForeground}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов к запуску"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>