<Window x:Class="FalloutLauncher.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление модами"
        Height="450" Width="420"
        MinHeight="300" MinWidth="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E1E"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="ModWindowBg" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ModTextFg" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="ModBtnBg" Color="#FF3A3A3A"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderThickness="1" BorderBrush="#FF3A3A3A" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsControl" Margin="4"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Сохранить" 
                    Width="100" Height="30"
                    Click="BtnSave_Click"
                    Background="#FF3A3A3A"
                    Foreground="#FFE0E0E0"
                    FontSize="13"
                    Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" 
                    Width="100" Height="30"
                    Click="BtnCancel_Click"
                    Background="#FF3A3A3A"
                    Foreground="#FFE0E0E0"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
